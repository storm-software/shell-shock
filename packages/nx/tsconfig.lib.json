{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "lib": ["esnext"],
    "rootDir": ".",
    "types": ["node"],
    "outDir": "./out-tsc",
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "references": [{ "path": "../core/tsconfig.lib.json" }],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "package.json",
    "powerlines.base.ts",
    "powerlines.plugin.ts",
    "powerlines.d.ts"
  ],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
